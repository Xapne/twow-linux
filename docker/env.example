# Copy to .env beside compose.yaml, then: docker compose up -d
# Compose reads .env on its own, so nothing else needs editing.

# Who reaches the realm. 127.0.0.1 keeps it to this machine; 0.0.0.0 opens it
# to the network the host sits on.
TWOW_PUBLISH_ON=0.0.0.0

# What clients are told to connect to, and what goes in realmlist.wtf. This is
# the host's own address on that network, which a container has no way to read.
TWOW_REALM_ADDRESS=192.168.1.50

# Which core the container builds and runs: stock, or bots for a world
# populated with AI players. Switching a converted container over later is
#   docker compose exec twow ./twow.sh bots on
TWOW_VARIANT=stock
